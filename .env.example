# ============================================================================
# FrameLab Eyewear - Environment Configuration Template
# ============================================================================
# Copy this file to `.env` and fill in your actual credentials.
# NEVER commit your production `.env` file containing live secrets to public git.

PORT=3000
NODE_ENV=development

# Razorpay Mode ('true' for Test Mode, 'false' for Production)
RAZORPAY_TEST_MODE=true

# Get your Test or Live API keys from Razorpay Dashboard:
# 1. Log in to https://dashboard.razorpay.com/
# 2. Go to Settings -> API Keys -> Generate Key
# 3. Paste your Key ID and Key Secret below:
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET

# Set up Webhook Secret at Razorpay Dashboard:
# 1. Go to Settings -> Webhooks -> Add New Webhook
# 2. Webhook URL: https://your-domain.com/api/webhook
# 3. Active Events: payment.captured, payment.failed, order.paid
# 4. Paste your Webhook Secret below:
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

STORE_NAME="FrameLab Haute Eyewear"
STORE_CURRENCY=INR

FREE_SHIPPING_THRESHOLD=1999
STANDARD_SHIPPING_FEE=0
EXPRESS_PRIORITY_SHIPPING_FEE=150
GST_PERCENTAGE=18
